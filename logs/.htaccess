# PoultryGuard - error logs must never be served over HTTP.
# They can contain file paths and query fragments useful to an attacker.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
